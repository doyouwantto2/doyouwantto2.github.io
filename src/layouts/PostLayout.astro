---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="relative w-full">
  <input id="tag-sidebar" type="checkbox" class="peer hidden" />

  <label
    for="tag-sidebar"
    class="pointer-events-none fixed inset-0 z-30 bg-black/50 opacity-0 transition-opacity peer-checked:pointer-events-auto peer-checked:opacity-100 md:hidden"
  ></label>

  <aside
    class="fixed right-0 top-0 z-40 h-full w-80 translate-x-full bg-gray-800 p-6 shadow-2xl transition-transform peer-checked:translate-x-0 md:hidden"
  >
    <div class="mb-4 flex items-center justify-between">
      <p class="text-xl font-bold">Tags</p>

      <label for="tag-sidebar" class="cursor-pointer text-2xl"> × </label>
    </div>

    <div class="flex flex-wrap gap-1 rounded-xl bg-gray-700 p-2">
      {
        tags.map((tag) => (
          <button
            type="button"
            data-tag={tag}
            class="m-2 cursor-pointer rounded-xl bg-gray-500 px-2 py-1"
          >
            #{tag}
          </button>
        ))
      }
    </div>

    <div class="mt-5 flex justify-start">
      <button
        type="button"
        data-search
        class="cursor-pointer rounded-xl px-14 py-2 bg-gray-600"
      >
        Search
      </button>
    </div>
  </aside>

  <label
    for="tag-sidebar"
    class="fixed bottom-12 right-12 z-30 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-cyan-800 text-xl shadow-lg md:hidden"
  >
    #
  </label>

  <div
    class="grid w-full grid-cols-1 pt-10 md:grid-cols-[1fr_minmax(0,56rem)_1fr]"
  >
    <aside class="hidden md:block md:pr-8">
      <div class="ml-auto w-80">
        <p class="mt-3 text-xl font-bold">Tags</p>

        <div class="mt-4 flex flex-wrap gap-1 rounded-xl bg-gray-700 p-2">
          {
            tags.map((tag) => (
              <button
                type="button"
                data-tag={tag}
                class="m-2 cursor-pointer rounded-xl bg-gray-500 px-2 py-1"
              >
                #{tag}
              </button>
            ))
          }
        </div>

        <div class="mt-5 flex justify-start">
          <button
            type="button"
            data-search
            class="cursor-pointer rounded-xl px-14 py-2 bg-gray-600"
          >
            Search
          </button>
        </div>
      </div>
    </aside>

    <main class="min-w-0 w-full">
      <slot />
    </main>

    <div></div>
  </div>
</div>

<script>
  const params = new URLSearchParams(window.location.search);

  const selected = new Set(params.getAll("tag"));

  const syncTag = (name: string) => {
    document
      .querySelectorAll<HTMLElement>(`[data-tag="${name}"]`)
      .forEach((element) => {
        const active = selected.has(name);

        element.classList.toggle("bg-white", active);
        element.classList.toggle("text-black", active);
      });
  };

  document.querySelectorAll<HTMLElement>("[data-tag]").forEach((tag) => {
    const name = tag.dataset.tag;

    if (!name) {
      return;
    }

    syncTag(name);

    tag.addEventListener("click", () => {
      if (selected.has(name)) {
        selected.delete(name);
      } else {
        selected.add(name);
      }

      syncTag(name);
    });
  });

  document.querySelectorAll<HTMLElement>("[data-search]").forEach((button) => {
    button.addEventListener("click", () => {
      const query = new URLSearchParams();

      selected.forEach((tag) => {
        query.append("tag", tag);
      });

      const search = query.toString();

      window.location.href = search ? `/blog?${search}` : "/blog";
    });
  });
</script>
