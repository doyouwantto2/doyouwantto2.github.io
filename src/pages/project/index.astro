---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectLayout from "@layouts/ProjectLayout.astro";
import MarkdownLayout from "@layouts/MarkdownLayout.astro";
import ProjectCard from "./components/_ProjectCard";
import Analysis from "./components/_Analysis";
import { siUpptime } from "simple-icons";

const projects = await getCollection("project");

const renderedProjects = await Promise.all(
  projects.map(async (project) => ({
    project,
    Content: (await render(project)).Content,
  })),
);

const analysisData = projects.map((p) => ({
  stack: (p.data.stack as string[]) ?? [],
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Project</title>
  </head>

  <BaseLayout>
    <ProjectLayout>
      <div slot="analysis">
        <Analysis client:load projects={analysisData} />
      </div>

      <div class="flex flex-col gap-12 m-5">
        {
          renderedProjects.map(({ project, Content }) => (
            <div class="p-5 rounded-2xl border border-gray-700 bg-gray-700">
              <ProjectCard client:load project={project} />

              <details class="group">
                <summary class="w-full border rounded-b-2xl group-open:rounded-none border-gray-600 cursor-pointer list-none items-center justify-center py-3 text-sm text-gray-400 hover:text-white [&::-webkit-details-marker]:hidden">
                  <div class="flex flex-row justify-center">
                    <span
                      class="inline-block w-6 h-6 group-open:rotate-180 [&_svg]:fill-white"
                      set:html={siUpptime.svg}
                    />
                  </div>
                </summary>

                <div class="rounded-b-2xl bg-gray-600 p-5">
                  <MarkdownLayout>
                    <Content />
                  </MarkdownLayout>
                </div>
              </details>
            </div>
          ))
        }
      </div>
    </ProjectLayout>
  </BaseLayout>
</html>
