---
import "@styles/global.css";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "./components/_PostCard";
import PostLayout from "@layouts/PostLayout.astro";
import Breadcrumb from "./components/_Breadcrumb";
import { getCollection } from "astro:content";

const posts = await getCollection("post");

const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Post</title>
  </head>

  <BaseLayout>
    <PostLayout tags={tags}>
      <Breadcrumb client:load name="Post" link="blog" id="" title="" />

      <div class="rounded-2xl border border-gray-700 bg-gray-700 p-5">
        <div class="flex flex-col gap-5">
          {
            posts.map((post) => (
              <div data-post data-tags={post.data.tags.join(",")}>
                <PostCard client:load post={post} />
              </div>
            ))
          }
        </div>
      </div>
    </PostLayout>
  </BaseLayout>
</html>

<script>
  const params = new URLSearchParams(window.location.search);
  const selectedTags = params.getAll("tag");

  document.querySelectorAll<HTMLElement>("[data-post]").forEach((post) => {
    const tags = post.dataset.tags?.split(",") ?? [];

    const visible =
      selectedTags.length === 0 ||
      selectedTags.every((tag) => tags.includes(tag));

    post.hidden = !visible;
  });
</script>
