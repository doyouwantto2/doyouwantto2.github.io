{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@styles/*": ["src/styles/*"],
      "@commons/*": ["src/commons/*"],
      "@layouts/*": ["src/layouts/*"],
      "@content/*": ["content/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}
