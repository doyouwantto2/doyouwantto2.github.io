import {
  createSignal,
  Index,
  For,
  onMount,
  onCleanup,
  createEffect,
} from "solid-js";
import { gsap } from "gsap";
import MainOrb from "./components/MainOrb";
import ChildOrb from "./components/ChildOrb";

interface PathProps {
  name: string;
  link: string;
}

const pathList: PathProps[] = [
  { name: "Home", link: "/" },
  { name: "Blog", link: "/blog" },
  { name: "Project", link: "/project" },
  { name: "Lab", link: "/lab" },
];

const readCssLengthPx = (
  el: HTMLElement | null,
  varName: string,
  fallback: number,
): number => {
  if (!el) return fallback;
  const raw = getComputedStyle(el).getPropertyValue(varName).trim();
  if (!raw) return fallback;
  const num = parseFloat(raw);
  if (Number.isNaN(num)) return fallback;
  if (raw.endsWith("rem")) {
    const root =
      parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    return num * root;
  }
  if (raw.endsWith("em")) {
    const fontSize = parseFloat(getComputedStyle(el).fontSize) || 16;
    return num * fontSize;
  }
  return num;
};

/**
 * Dây nối từ rìa MainOrb → rìa ChildOrb.
 * - Cong nhẹ (quadratic bezier) để trông như dây thật.
 * - Khi mở: endpoint duỗi ra đồng bộ với orb (0.1s), bow vung lên rồi tắt dần
 *   → cảm giác dây có đàn hồi/quán tính.
 */
function ConnectionLine(props: {
  angle: number;
  innerRadius: number;
  outerRadius: number;
  open: boolean;
}) {
  const [progress, setProgress] = createSignal(0); // 0..1 — vị trí endpoint
  const [bow, setBow] = createSignal(0); // độ cong theo phương vuông góc
  let tl: gsap.core.Timeline | undefined;

  const cos = () => Math.cos(props.angle);
  const sin = () => Math.sin(props.angle);

  const startPt = () => ({
    x: props.innerRadius * cos(),
    y: -props.innerRadius * sin(),
  });

  const endPt = () => {
    const t = progress();
    const r = props.innerRadius + (props.outerRadius - props.innerRadius) * t;
    return { x: r * cos(), y: -r * sin() };
  };

  // Vector vuông góc — dùng để đẩy control point ra khỏi đường thẳng
  const perp = () => ({ x: sin(), y: cos() });

  const d = () => {
    const s = startPt();
    const e = endPt();
    const p = perp();
    const midX = (s.x + e.x) / 2;
    const midY = (s.y + e.y) / 2;
    const cx = midX + p.x * bow();
    const cy = midY + p.y * bow();
    return `M ${s.x} ${s.y} Q ${cx} ${cy} ${e.x} ${e.y}`;
  };

  onMount(() => {
    const state = { p: 0, b: 0 };

    tl = gsap.timeline({ paused: true });

    // Endpoint duỗi ra — khớp timing với orb
    tl.to(
      state,
      {
        p: 1,
        duration: 0.1,
        delay: 0.02,
        ease: "power1.out",
        onUpdate: () => setProgress(state.p),
      },
      0,
    );

    // Bow "vung" — nhô lên, bật lại, tắt dần
    tl.to(
      state,
      {
        b: 16,
        duration: 0.14,
        ease: "power3.out",
        onUpdate: () => setBow(state.b),
      },
      0.02,
    );
    tl.to(
      state,
      {
        b: -6,
        duration: 0.18,
        ease: "power2.inOut",
        onUpdate: () => setBow(state.b),
      },
      0.16,
    );
    tl.to(
      state,
      {
        b: 2,
        duration: 0.16,
        ease: "power2.inOut",
        onUpdate: () => setBow(state.b),
      },
      0.34,
    );
    tl.to(
      state,
      {
        b: 0,
        duration: 0.18,
        ease: "power2.out",
        onUpdate: () => setBow(state.b),
      },
      0.5,
    );
  });

  createEffect(() => {
    if (!tl) return;
    if (props.open) tl.play();
    else tl.reverse();
  });

  onCleanup(() => {
    tl?.kill();
  });

  return (
    <path
      d={d()}
      fill="none"
      stroke="rgba(255,255,255,0.75)"
      stroke-width="2"
      stroke-linecap="round"
      pathLength="1"
      stroke-dasharray="1"
      stroke-dashoffset={props.open ? 0 : 1}
      style={{
        transition:
          "stroke-dashoffset 320ms cubic-bezier(0.34, 1.1, 0.64, 1), opacity 240ms ease-out",
        opacity: props.open ? 1 : 0,
      }}
    />
  );
}

export default function Switcher({ currentPath }: { currentPath: string }) {
  const [open, setOpen] = createSignal(false);
  const [radius, setRadius] = createSignal(180);
  const [innerRadius, setInnerRadius] = createSignal(36);
  const [childRadius, setChildRadius] = createSignal(48);

  let switcherRef: HTMLDivElement | undefined;
  let anchorRef: HTMLDivElement | undefined;

  const current = () => {
    const sorted = [...pathList].sort((a, b) => b.link.length - a.link.length);
    return sorted.find((item) => currentPath.startsWith(item.link));
  };

  const children = () => {
    const currentIndex = pathList.findIndex(
      (item) => item.link === current()?.link,
    );

    return Array.from(
      { length: pathList.length - 1 },
      (_, i) => pathList[(currentIndex + 1 + i) % pathList.length],
    );
  };

  const handleOutsideClick = (event: MouseEvent) => {
    if (!open()) return;
    const target = event.target as Node;
    if (switcherRef && !switcherRef.contains(target)) {
      setOpen(false);
    }
  };

  onMount(() => {
    document.addEventListener("click", handleOutsideClick);

    const updateRadii = () => {
      setRadius(readCssLengthPx(anchorRef ?? null, "--orb-r", 180));
      setInnerRadius(readCssLengthPx(anchorRef ?? null, "--orb-inner-r", 36));
      setChildRadius(readCssLengthPx(anchorRef ?? null, "--orb-child-r", 48));
    };
    updateRadii();
    window.addEventListener("resize", updateRadii);

    onCleanup(() => {
      document.removeEventListener("click", handleOutsideClick);
      window.removeEventListener("resize", updateRadii);
    });
  });

  return (
    <div
      ref={switcherRef}
      class="
        fixed z-10

        left-[5em] bottom-[5em]
        sm:left-[7em] sm:bottom-[7em]
        md:left-[7em] md:bottom-[7em]
        lg:left-[8em] lg:bottom-[8em]
      "
    >
      <div
        ref={anchorRef}
        class="
          relative h-0 w-0

          [--orb-r:150px]
          sm:[--orb-r:150px]
          md:[--orb-r:180px]
          lg:[--orb-r:200px]

          [--orb-inner-r:32px]
          sm:[--orb-inner-r:34px]
          md:[--orb-inner-r:36px]
          lg:[--orb-inner-r:38px]

          [--orb-child-r:48px]
          sm:[--orb-child-r:48px]
          md:[--orb-child-r:48px]
          lg:[--orb-child-r:52px]
        "
      >
        <svg
          class="pointer-events-none absolute top-0 left-0"
          style={{ overflow: "visible" }}
          width="1"
          height="1"
          aria-hidden="true"
        >
          <For each={children()}>
            {(_, i) => {
              const angle = () =>
                (Math.PI / 2) * (i() / Math.max(children().length - 1, 1));

              return (
                <ConnectionLine
                  angle={angle()}
                  innerRadius={innerRadius()}
                  outerRadius={radius() - childRadius()}
                  open={open()}
                />
              );
            }}
          </For>
        </svg>

        <div
          class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2"
          onClick={() => setOpen((value) => !value)}
        >
          <MainOrb
            class={`
              flex cursor-pointer items-center justify-center
              rounded-full
              bg-white/70
              text-black
              ring-1 ring-white/50
              transition-all duration-300 ease-in-out

              ${
                open()
                  ? "opacity-100 hover:bg-white/85"
                  : "opacity-90 hover:opacity-100 hover:bg-white/85"
              }

              ${
                open()
                  ? "h-15 w-15 sm:h-16 sm:w-16 md:h-17 md:w-17 lg:h-18 lg:w-18"
                  : "h-19 w-19 sm:w-20 sm:h-20 md:h-21 md:w-21 lg:h-22 lg:w-22"
              }
            `}
            open={open()}
            name={current()?.name ?? ""}
          />
        </div>

        <div class="pointer-events-none absolute top-0 left-0 h-0 w-0">
          <Index each={children()}>
            {(element, index) => (
              <ChildOrb
                name={element().name}
                link={element().link}
                order={index}
                total={children().length}
                open={open()}
              />
            )}
          </Index>
        </div>
      </div>
    </div>
  );
}
